#!/bin/sh
# Kiểm tra dòng tiêu đề commit theo Conventional Commits.
#   <type>(<scope>): <mô tả ngắn, thể mệnh lệnh, không viết hoa, không dấu chấm>
# Xem CONTRIBUTING.md. Merge/Revert tự sinh được bỏ qua.

msg_file="$1"
subject=$(head -n 1 "$msg_file")

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9-]+\))?!?: [^A-Z.].{0,70}[^.]$"

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "✗ Tiêu đề commit không đúng quy ước:"
  echo "    $subject"
  echo "  Dạng đúng : <type>(<scope>): <mô tả>   ví dụ: feat(payroll): add payslip layout editor"
  echo "  type      : $types"
  echo "  Tối đa 72 ký tự, mô tả bắt đầu chữ thường, không kết thúc bằng dấu chấm."
  exit 1
fi

# Không dùng mã/thuật ngữ trong tài liệu đặc tả để đặt tên commit.
if printf '%s' "$subject" | grep -Eiq '\b(br-?pay|fr-?[0-9]{2}|m0[0-9]|f0[0-9]{3,4}|srs|dmkl)\b'; then
  echo "✗ Tiêu đề commit đang dùng mã/thuật ngữ của tài liệu đặc tả."
  echo "  Hãy mô tả bằng tên tính năng thực tế (payroll, kpi, attendance, ...)."
  exit 1
fi
exit 0
